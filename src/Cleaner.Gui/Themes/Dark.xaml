<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 暗色设计令牌，语义名与 Light.xaml 一一对应。 -->
  <Color x:Key="AccentColor">#FF818CF8</Color>
  <Color x:Key="AccentHoverColor">#FFA5B4FC</Color>
  <Color x:Key="AccentPressedColor">#FF6366F1</Color>
  <Color x:Key="DangerColor">#FFF87171</Color>
  <Color x:Key="WarnColor">#FFFBBF24</Color>
  <Color x:Key="OkColor">#FF4ADE80</Color>

  <SolidColorBrush x:Key="WindowBackground" Color="#FF11131A" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FF1A1D27" />
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF222633" />
  <SolidColorBrush x:Key="DividerBrush" Color="#FF2E3342" />
  <SolidColorBrush x:Key="HoverBrush" Color="#FF262B3A" />

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF3F4F8" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA6ACC0" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF71788C" />
  <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FF10121A" />

  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
  <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />

  <SolidColorBrush x:Key="ChipBackground" Color="#FF1A1D27" />
  <SolidColorBrush x:Key="ChipBorder" Color="#FF333949" />
  <SolidColorBrush x:Key="ChipCheckedBackground" Color="#FF2A2C4A" />
  <SolidColorBrush x:Key="ChipCheckedBorder" Color="{StaticResource AccentColor}" />

  <Thickness x:Key="CardPadding">16,13</Thickness>
  <CornerRadius x:Key="CardRadius">12</CornerRadius>
  <CornerRadius x:Key="ControlRadius">8</CornerRadius>
  <CornerRadius x:Key="PillRadius">999</CornerRadius>

</ResourceDictionary>
