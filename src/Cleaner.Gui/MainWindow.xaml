<Window x:Class="DeleInfo.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="DeleInfo — 登录态清理"
        Width="1080" Height="760" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Background="{DynamicResource WindowBackground}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>

  <DockPanel Margin="18,16,18,14">

    <!-- ===== 顶部：品牌 + 主题切换 ===== -->
    <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Width="38" Height="38" CornerRadius="11"
              Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
        <TextBlock Text="D" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextOnAccentBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="DeleInfo" Style="{StaticResource Title}" />
        <TextBlock Text="只清别人留下的登录态 · 书签、历史与聊天记录不动" Style="{StaticResource Subtitle}" />
      </StackPanel>

      <Button Grid.Column="2" x:Name="BtnTheme" Content="深色模式" Style="{StaticResource SecondaryButton}"
              Click="OnToggleTheme" Margin="0,0,8,0" />
      <Button Grid.Column="3" x:Name="BtnOpenSnap" Content="快照目录" Style="{StaticResource SecondaryButton}"
              Click="OnOpenSnapshots" />
    </Grid>

    <!-- ===== 动作条 ===== -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <Button x:Name="BtnScan" Content="扫描" Style="{StaticResource PrimaryButton}" Click="OnScan"
              MinWidth="104" Margin="0,0,10,0" />
      <Button x:Name="BtnClean" Content="清理勾选（可还原）" Style="{StaticResource SecondaryButton}"
              Click="OnClean" Margin="0,0,8,0" IsEnabled="False" />
      <Button x:Name="BtnHard" Content="彻底清理（不可还原）" Style="{StaticResource DangerButton}"
              Click="OnHard" Margin="0,0,8,0" IsEnabled="False" />
      <Button x:Name="BtnRestore" Content="还原上次快照" Style="{StaticResource SecondaryButton}"
              Click="OnRestore" Margin="0,0,8,0" IsEnabled="False" />
      <Button x:Name="BtnPurge" Content="清空所有快照" Style="{StaticResource DangerButton}"
              Click="OnPurge" IsEnabled="False" />
    </StackPanel>

    <!-- ===== 范围选项：芯片式开关 ===== -->
    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal">
        <CheckBox x:Name="ChkLevel2" Style="{StaticResource Chip}" Content="包含 L2 密码 / 凭据 / 自动填充" IsChecked="True" />
        <CheckBox x:Name="ChkHeuristic" Style="{StaticResource Chip}" Content="包含启发式命中的原生文件与域凭据" />
        <CheckBox x:Name="ChkRunning" Style="{StaticResource Chip}" Content="包括正在运行的应用" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="全选" Style="{StaticResource SecondaryButton}" Click="OnSelectAll" Padding="12,6" />
        <Button Content="全不选" Style="{StaticResource SecondaryButton}" Click="OnSelectNone" Padding="12,6" Margin="8,0,0,0" />
        <Button Content="只清登出" Style="{StaticResource SecondaryButton}" Click="OnSelectL1" Padding="12,6" Margin="8,0,0,0" />
      </StackPanel>
    </Grid>

    <!-- ===== 汇总统计卡 ===== -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Padding="18,14" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock x:Name="StatSize" Text="—" Style="{StaticResource StatValue}" />
          <TextBlock Text="勾选体积" Style="{StaticResource StatLabel}" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock x:Name="StatCount" Text="—" Style="{StaticResource StatValue}" />
          <TextBlock Text="勾选项目" Style="{StaticResource StatLabel}" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="4">
          <TextBlock x:Name="StatApps" Text="—" Style="{StaticResource StatValue}" />
          <TextBlock Text="涉及应用" Style="{StaticResource StatLabel}" Margin="0,2,0,0" />
        </StackPanel>
        <TextBlock Grid.Column="5" x:Name="SummaryText" Style="{StaticResource Caption}"
                   Text="尚未扫描。点上方「扫描」开始。" TextWrapping="Wrap"
                   VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="380"
                   TextAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
      </Grid>
    </Border>

    <!-- ===== 底部：进度 + 日志 ===== -->
    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ProgressBar Grid.Column="0" x:Name="Progress" Style="{StaticResource ThinProgress}"
                     VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button Grid.Column="1" x:Name="BtnCancel" Content="取消剩余项" Style="{StaticResource SecondaryButton}"
                Click="OnCancel" IsEnabled="False" Padding="12,6" Margin="0,0,8,0" />
        <Button Grid.Column="2" Content="清理历史" Style="{StaticResource SecondaryButton}"
                Click="OnHistory" Padding="12,6" />
      </Grid>

      <Expander Grid.Row="1" x:Name="LogPanel" Header="运行日志" IsExpanded="False" Margin="0,10,0,0"
                Foreground="{DynamicResource TextSecondaryBrush}">
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1" CornerRadius="10" Height="130" Margin="0,8,0,0">
          <TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                   Foreground="{DynamicResource TextSecondaryBrush}" Padding="12,9"
                   FontFamily="Cascadia Mono, Consolas" FontSize="12"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </Border>
      </Expander>
    </Grid>

    <!-- ===== 主体：应用卡片列表 ===== -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
      <Grid>
        <!-- 空状态 -->
        <Border x:Name="EmptyHint" Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Padding="0,64"
                Visibility="{Binding ElementName=Groups, Path=Items.IsEmpty, Converter={StaticResource BoolToVis}}">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="还没有扫描结果" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="点上方「扫描」，工具会列出各浏览器与应用里保存的登录态。"
                       Style="{StaticResource Caption}" Margin="0,7,0,0" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <ItemsControl x:Name="Groups">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}"
                      BorderThickness="1" CornerRadius="12" Margin="0,0,0,10">
                <StackPanel>

                  <!-- 卡片头 -->
                  <Grid Margin="14,11">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="14" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 覆盖式展开开关：整行可点，但排在最下层，不挡勾选框 -->
                    <ToggleButton Grid.ColumnSpan="9" Background="Transparent" BorderThickness="0"
                                  Cursor="Hand" IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                      <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                          <Border x:Name="H" Background="Transparent" CornerRadius="11">
                            <ContentPresenter />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="H" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </ToggleButton.Template>
                    </ToggleButton>

                    <!-- 视觉内容（不吃命中，让点击落到下面的开关） -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" IsHitTestVisible="False">
                      <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource SurfaceAltBrush}">
                        <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                      <TextBlock Text="{Binding App}" Style="{StaticResource SectionTitle}" />
                      <TextBlock Text="{Binding Kind}" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                    </StackPanel>

                    <Border Grid.Column="4" Style="{StaticResource Badge}" IsHitTestVisible="False">
                      <Border.Resources>
                        <Style x:Key="BadgeT" TargetType="TextBlock" BasedOn="{StaticResource BadgeText}" />
                      </Border.Resources>
                      <TextBlock Text="{Binding BadgeText}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding BadgeText}" Value="宿主运行中">
                                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding BadgeText}" Value="需确认">
                                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding BadgeText}" Value="已处理">
                                <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>

                    <TextBlock Grid.Column="6" Text="{Binding SizeText}" IsHitTestVisible="False"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <TextBlock Grid.Column="8" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource TextTertiaryBrush}">
                      <TextBlock.RenderTransform>
                        <RotateTransform Angle="0" CenterX="6" CenterY="6" />
                      </TextBlock.RenderTransform>
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                              <Setter Property="RenderTransform">
                                <Setter.Value>
                                  <RotateTransform Angle="180" CenterX="6" CenterY="6" />
                                </Setter.Value>
                              </Setter>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>

                    <!-- 最上层：整体三态勾选 -->
                    <CheckBox Grid.Column="0" Style="{StaticResource SquareCheck}"
                              IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center" />
                  </Grid>

                  <!-- 明细 -->
                  <ItemsControl ItemsSource="{Binding Rows}" Margin="14,0,14,10"
                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,4">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="92" />
                          </Grid.ColumnDefinitions>

                          <CheckBox Grid.Column="0" Style="{StaticResource SquareCheck}"
                                    IsChecked="{Binding Selected, Mode=TwoWay}" />

                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Item}" FontSize="12.5"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Location}" FontSize="11" Margin="0,1,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                          </StackPanel>

                          <Border Grid.Column="2" Style="{StaticResource Badge}" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Level}" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                          </Border>

                          <TextBlock Grid.Column="3" Text="{Binding Size}" FontSize="12" TextAlignment="Right"
                                     VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />

                          <TextBlock Grid.Column="4" Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold"
                                     TextAlignment="Right" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
