<Window x:Class="DeleInfo.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeleInfo.Gui"
        Title="DeleInfo — 登录态清理"
        Width="1180" Height="720" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        Background="#F3F4F6">
  <DockPanel Margin="12">

    <!-- 工具栏 -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <Button x:Name="BtnScan" Content="扫描" Click="OnScan" />
      <Button x:Name="BtnClean" Content="清理勾选（可还原）" Click="OnClean" IsEnabled="False" />
      <Button x:Name="BtnHard" Content="彻底清理（不可还原）" Click="OnHard" IsEnabled="False" />
      <Button x:Name="BtnRestore" Content="还原上次快照" Click="OnRestore" IsEnabled="False" />
      <Button x:Name="BtnPurge" Content="清空所有快照" Click="OnPurge" IsEnabled="False" />
      <Button x:Name="BtnOpenSnap" Content="打开快照目录" Click="OnOpenSnapshots" MinWidth="80" />
    </StackPanel>

    <!-- 范围选项 -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <CheckBox x:Name="ChkLevel2" Content="包含 L2（保存的密码 / 凭据 / 自动填充）" IsChecked="True" />
      <CheckBox x:Name="ChkHeuristic" Content="包含启发式命中的原生文件与域凭据" />
      <CheckBox x:Name="ChkRunning" Content="包括正在运行的应用（先关掉再清更安全）" />
      <Separator Width="16" Background="Transparent" />
      <TextBlock Text="选择：" VerticalAlignment="Center" />
      <Button Content="全选" Click="OnSelectAll" MinWidth="56" Margin="6,0,0,0" />
      <Button Content="全不选" Click="OnSelectNone" MinWidth="64" Margin="6,0,0,0" />
      <Button Content="只清登出(L1)" Click="OnSelectL1" MinWidth="110" Margin="6,0,0,0" />
    </StackPanel>

    <!-- 汇总条 -->
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
            CornerRadius="4" Padding="10,7" Margin="0,0,0,8">
      <TextBlock x:Name="SummaryText" Text="尚未扫描。书签、扩展、历史、聊天记录不在任何清理范围内。"
                 TextWrapping="Wrap" />
    </Border>

    <!-- 日志 -->
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
            CornerRadius="4" Height="132" Margin="0,8,0,0">
      <TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0" VerticalScrollBarVisibility="Auto"
               TextWrapping="NoWrap" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Padding="8" />
    </Border>

    <!-- 明细 -->
    <ListView x:Name="Rows" Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              SelectionMode="Extended">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="选" Width="44">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding Done, Converter={x:Static local:InverseBool.Instance}}"
                          HorizontalAlignment="Center" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="应用" Width="180" DisplayMemberBinding="{Binding App}" />
          <GridViewColumn Header="账号 / 分区" Width="190" DisplayMemberBinding="{Binding Profile}" />
          <GridViewColumn Header="登录态" Width="230" DisplayMemberBinding="{Binding Item}" />
          <GridViewColumn Header="级别" Width="78" DisplayMemberBinding="{Binding Level}" />
          <GridViewColumn Header="大小" Width="86" DisplayMemberBinding="{Binding Size}" />
          <GridViewColumn Header="文件" Width="70" DisplayMemberBinding="{Binding Files}" />
          <GridViewColumn Header="状态" Width="92" DisplayMemberBinding="{Binding Status}" />
          <GridViewColumn Header="路径" Width="430" DisplayMemberBinding="{Binding Path}" />
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
